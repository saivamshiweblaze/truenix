# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Public (shipped to browsers; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable or anon key>
# Optional: canonical site URL used in email links (defaults to the request host)
NEXT_PUBLIC_SITE_URL=https://truenix.vercel.app

# Server only — NEVER prefix with NEXT_PUBLIC_. Needed for admin operations, account deletion and the beta bootstrap.
SUPABASE_SERVICE_ROLE_KEY=<service_role or sb_secret key>
